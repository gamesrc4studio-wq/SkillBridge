rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // PRIMITIVE HELPERS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'games.rc4.studio@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidStringList(arr, maxItems) {
      return arr is list && arr.size() <= maxItems && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 100));
    }

    function isValidUidList(arr, maxItems) {
      return arr is list && arr.size() <= maxItems && (arr.size() == 0 || isValidId(arr[0]));
    }

    // =========================================================================
    // VALIDATION BLUEPRINTS (Strict Schema + Blueprint Constants)
    // =========================================================================

    function isValidUserProfile(data, uid) {
      return data.userId == uid
        && isValidId(data.userId)
        && isValidString(data.name, 1, 100)
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 40 && data.username.matches('^[a-zA-Z0-9_\\-]+$')
        && (!('avatarUrl' in data) || isValidString(data.avatarUrl, 0, 500))
        && (!('bio' in data) || isValidString(data.bio, 0, 600))
        && (!('education' in data) || isValidString(data.education, 0, 120))
        && (!('college' in data) || isValidString(data.college, 0, 150))
        && isValidStringList(data.skills, 25)
        && (!('skillLevels' in data) || data.skillLevels is map)
        && data.experience in ['Student', 'Entry', 'Intermediate', 'Senior']
        && (!('github' in data) || isValidString(data.github, 0, 300))
        && (!('portfolio' in data) || isValidString(data.portfolio, 0, 300))
        && (!('interests' in data) || isValidStringList(data.interests, 20))
        && data.availability in ['Available', 'Part-time', 'Weekends Only', 'Busy']
        && (!('preferredCategories' in data) || isValidStringList(data.preferredCategories, 10))
        && data.isPublic is bool
        && data.profileCompleted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateAccount(data, uid) {
      return data.userId == uid
        && isValidId(data.userId)
        && isValidString(data.email, 0, 200)
        && isValidStringList(data.savedProjectIds, 50)
        && data.updatedAt is timestamp;
    }

    function isValidProject(data) {
      return isValidId(data.projectId)
        && isValidId(data.ownerId)
        && isValidString(data.ownerName, 1, 100)
        && isValidString(data.title, 2, 140)
        && isValidString(data.description, 10, 3000)
        && data.category in ['Web Development', 'Artificial Intelligence', 'Machine Learning', 'Mobile Applications', 'Data Science', 'Cybersecurity', 'Blockchain', 'Other']
        && data.projectType in ['Open Source', 'Startup', 'Academic', 'Hackathon', 'Research']
        && isValidStringList(data.requiredSkills, 25)
        && data.teamSize is number && data.teamSize >= 1 && data.teamSize <= 20
        && data.experienceRequired in ['Any', 'Student', 'Entry', 'Intermediate', 'Senior']
        && isValidString(data.duration, 1, 60)
        && data.difficulty in ['Beginner', 'Intermediate', 'Advanced']
        && data.openPositions is number && data.openPositions >= 0 && data.openPositions <= 20
        && data.visibility in ['Public', 'Private']
        && data.status in ['Open', 'In Progress', 'Recruitment Closed', 'Completed']
        && (!('objectives' in data) || isValidStringList(data.objectives, 15))
        && (!('technologies' in data) || isValidStringList(data.technologies, 25))
        && isValidUidList(data.memberIds, 20)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTeam(data) {
      return isValidId(data.teamId)
        && isValidId(data.projectId)
        && isValidString(data.projectTitle, 1, 140)
        && isValidId(data.ownerId)
        && isValidUidList(data.memberIds, 20)
        && data.members is list && data.members.size() <= 20
        && data.skillCoverage is number && data.skillCoverage >= 0 && data.skillCoverage <= 100
        && isValidStringList(data.coveredSkills, 25)
        && data.status in ['Active', 'Completed', 'Archived']
        && (!('sharedNotes' in data) || isValidString(data.sharedNotes, 0, 5000))
        && (!('announcements' in data) || (data.announcements is list && data.announcements.size() <= 50))
        && (!('milestones' in data) || (data.milestones is list && data.milestones.size() <= 30))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvitation(data) {
      return isValidId(data.invitationId)
        && data.type in ['invite', 'join_request']
        && isValidId(data.projectId)
        && isValidString(data.projectTitle, 1, 140)
        && isValidId(data.senderId)
        && isValidString(data.senderName, 1, 100)
        && isValidId(data.receiverId)
        && isValidString(data.receiverName, 1, 100)
        && isValidId(data.applicantId)
        && isValidString(data.applicantName, 1, 100)
        && (!('roleSuggested' in data) || isValidString(data.roleSuggested, 0, 80))
        && (!('message' in data) || isValidString(data.message, 0, 600))
        && data.status in ['Pending', 'Accepted', 'Rejected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTask(data) {
      return isValidId(data.taskId)
        && isValidId(data.projectId)
        && isValidId(data.teamId)
        && isValidId(data.projectOwnerId)
        && isValidUidList(data.teamMemberIds, 20)
        && isValidString(data.title, 2, 160)
        && (!('description' in data) || isValidString(data.description, 0, 1500))
        && (!('assignedTo' in data) || isValidString(data.assignedTo, 0, 128))
        && (!('assignedToName' in data) || isValidString(data.assignedToName, 0, 100))
        && isValidId(data.createdBy)
        && data.status in ['To Do', 'In Progress', 'Completed']
        && data.priority in ['Low', 'Medium', 'High']
        && (!('dueDate' in data) || isValidString(data.dueDate, 0, 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data) {
      return isValidId(data.messageId)
        && isValidId(data.projectId)
        && data.channel in ['general', 'engineering', 'design', 'milestones']
        && isValidId(data.senderId)
        && isValidString(data.senderName, 1, 100)
        && (!('senderAvatar' in data) || isValidString(data.senderAvatar, 0, 500))
        && isValidString(data.message, 1, 2000)
        && isValidId(data.projectOwnerId)
        && isValidUidList(data.teamMemberIds, 20)
        && data.timestamp is timestamp;
    }

    function isValidNotification(data) {
      return isValidId(data.notificationId)
        && isValidId(data.userId)
        && isValidId(data.actorId)
        && data.type in ['invitation', 'invitation_accepted', 'invitation_rejected', 'join_request', 'task_assigned', 'task_updated', 'announcement', 'project_update']
        && isValidString(data.message, 1, 500)
        && (!('linkView' in data) || isValidString(data.linkView, 0, 80))
        && data.read is bool
        && data.timestamp is timestamp;
    }

    function isValidReport(data) {
      return isValidId(data.reportId)
        && isValidId(data.reporterId)
        && data.targetType in ['user', 'project']
        && isValidId(data.targetId)
        && isValidString(data.targetTitle, 1, 160)
        && isValidString(data.reason, 5, 1000)
        && data.status in ['Pending', 'Reviewed', 'Resolved', 'Dismissed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedAnalysis(data) {
      return isValidId(data.analysisId)
        && isValidId(data.userId)
        && isValidString(data.ideaPrompt, 5, 2000)
        && data.result is map
        && data.createdAt is timestamp;
    }

    function isValidActivity(data) {
      return isValidId(data.activityId)
        && isValidId(data.userId)
        && isValidString(data.action, 2, 120)
        && isValidString(data.targetTitle, 1, 160)
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.timestamp is timestamp;
    }

    // =========================================================================
    // MASTER GATE RELATIONAL HELPERS (used in single-doc create/update/delete)
    // =========================================================================

    function isProjectMember(projectId) {
      let proj = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return proj.ownerId == request.auth.uid || request.auth.uid in proj.memberIds;
    }

    // =========================================================================
    // COLLECTION RULES
    // =========================================================================

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (existing().isPublic == true || isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (existing().isPublic == true || existing().userId == request.auth.uid || isAdmin());

      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && incoming().keys().hasAll(['userId', 'name', 'username', 'skills', 'experience', 'availability', 'isPublic', 'profileCompleted', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['userId', 'name', 'username', 'avatarUrl', 'bio', 'education', 'college', 'skills', 'skillLevels', 'experience', 'github', 'portfolio', 'interests', 'availability', 'preferredCategories', 'isPublic', 'profileCompleted', 'createdAt', 'updatedAt'])
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'username', 'avatarUrl', 'bio', 'education', 'college',
            'skills', 'skillLevels', 'experience', 'github', 'portfolio',
            'interests', 'availability', 'preferredCategories', 'isPublic',
            'profileCompleted', 'updatedAt'
          ]))
        );

      allow delete: if isValidId(userId) && isAdmin();

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(userId) && docId == 'account'
          && isVerified() && isOwner(userId)
          && incoming().keys().hasAll(['userId', 'email', 'savedProjectIds', 'updatedAt'])
          && incoming().keys().hasOnly(['userId', 'email', 'savedProjectIds', 'updatedAt'])
          && isValidPrivateAccount(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && docId == 'account'
          && isVerified() && isOwner(userId)
          && isValidPrivateAccount(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'savedProjectIds', 'updatedAt']);
        allow delete: if false;
      }
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isSignedIn() && (
        existing().visibility == 'Public' ||
        existing().ownerId == request.auth.uid ||
        request.auth.uid in existing().memberIds ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().visibility == 'Public' ||
        existing().ownerId == request.auth.uid ||
        request.auth.uid in existing().memberIds ||
        isAdmin()
      );

      allow create: if isValidId(projectId)
        && isVerified()
        && incoming().projectId == projectId
        && incoming().ownerId == request.auth.uid
        && request.auth.uid in incoming().memberIds
        && incoming().keys().hasAll(['projectId', 'ownerId', 'ownerName', 'title', 'description', 'category', 'projectType', 'requiredSkills', 'teamSize', 'experienceRequired', 'duration', 'difficulty', 'openPositions', 'visibility', 'status', 'memberIds', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['projectId', 'ownerId', 'ownerName', 'title', 'description', 'category', 'projectType', 'requiredSkills', 'teamSize', 'experienceRequired', 'duration', 'difficulty', 'openPositions', 'visibility', 'status', 'objectives', 'technologies', 'memberIds', 'createdAt', 'updatedAt'])
        && isValidProject(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(projectId)
        && isVerified()
        && isValidProject(incoming())
        && incoming().projectId == existing().projectId
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'category', 'projectType', 'requiredSkills',
            'teamSize', 'experienceRequired', 'duration', 'difficulty',
            'openPositions', 'visibility', 'status', 'objectives', 'technologies',
            'memberIds', 'updatedAt'
          ])) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'openPositions', 'updatedAt']) &&
            !(request.auth.uid in existing().memberIds) &&
            request.auth.uid in incoming().memberIds &&
            incoming().memberIds.hasAll(existing().memberIds) &&
            incoming().memberIds.size() == existing().memberIds.size() + 1 &&
            get(/databases/$(database)/documents/invitations/$(projectId + '_' + request.auth.uid)).data.receiverId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/invitations/$(projectId + '_' + request.auth.uid)).data.status == 'Accepted'
          )
        );

      allow delete: if isValidId(projectId) && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /teams/{teamId} {
      allow get: if isValidId(teamId) && isSignedIn() && (
        resource == null ||
        existing().ownerId == request.auth.uid ||
        request.auth.uid in existing().memberIds ||
        (
          exists(/databases/$(database)/documents/invitations/$(existing().projectId + '_' + request.auth.uid)) &&
          get(/databases/$(database)/documents/invitations/$(existing().projectId + '_' + request.auth.uid)).data.receiverId == request.auth.uid
        ) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().ownerId == request.auth.uid ||
        request.auth.uid in existing().memberIds ||
        isAdmin()
      );

      allow create: if isValidId(teamId)
        && isVerified()
        && incoming().teamId == teamId
        && incoming().ownerId == request.auth.uid
        && incoming().keys().hasAll(['teamId', 'projectId', 'projectTitle', 'ownerId', 'memberIds', 'members', 'skillCoverage', 'coveredSkills', 'status', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['teamId', 'projectId', 'projectTitle', 'ownerId', 'memberIds', 'members', 'skillCoverage', 'coveredSkills', 'status', 'sharedNotes', 'announcements', 'milestones', 'createdAt', 'updatedAt'])
        && isValidTeam(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid;

      allow update: if isValidId(teamId)
        && isVerified()
        && isValidTeam(incoming())
        && incoming().teamId == existing().teamId
        && incoming().projectId == existing().projectId
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && existing().status != 'Completed' && incoming().diff(existing()).affectedKeys().hasOnly([
            'projectTitle', 'memberIds', 'members', 'skillCoverage', 'coveredSkills', 'status', 'sharedNotes', 'announcements', 'milestones', 'updatedAt'
          ])) ||
          (request.auth.uid in existing().memberIds && existing().status == 'Active' && incoming().diff(existing()).affectedKeys().hasOnly([
            'sharedNotes', 'announcements', 'milestones', 'updatedAt'
          ])) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'members', 'updatedAt']) &&
            !(request.auth.uid in existing().memberIds) &&
            request.auth.uid in incoming().memberIds &&
            incoming().memberIds.hasAll(existing().memberIds) &&
            incoming().memberIds.size() == existing().memberIds.size() + 1 &&
            get(/databases/$(database)/documents/invitations/$(existing().projectId + '_' + request.auth.uid)).data.receiverId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/invitations/$(existing().projectId + '_' + request.auth.uid)).data.status == 'Accepted'
          )
        );

      allow delete: if isValidId(teamId) && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /invitations/{invitationId} {
      allow get: if isValidId(invitationId) && isSignedIn() && (
        existing().senderId == request.auth.uid ||
        existing().receiverId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().senderId == request.auth.uid ||
        existing().receiverId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isValidId(invitationId)
        && isVerified()
        && incoming().invitationId == invitationId
        && incoming().senderId == request.auth.uid
        && incoming().status == 'Pending'
        && incoming().keys().hasAll(['invitationId', 'type', 'projectId', 'projectTitle', 'senderId', 'senderName', 'receiverId', 'receiverName', 'applicantId', 'applicantName', 'status', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['invitationId', 'type', 'projectId', 'projectTitle', 'senderId', 'senderName', 'receiverId', 'receiverName', 'applicantId', 'applicantName', 'roleSuggested', 'message', 'status', 'createdAt', 'updatedAt'])
        && isValidInvitation(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && (
          (incoming().type == 'invite' && get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid) ||
          (incoming().type == 'join_request' && incoming().applicantId == request.auth.uid && get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == incoming().receiverId)
        );

      allow update: if isValidId(invitationId)
        && isVerified()
        && isValidInvitation(incoming())
        && incoming().invitationId == existing().invitationId
        && incoming().projectId == existing().projectId
        && incoming().senderId == existing().senderId
        && incoming().receiverId == existing().receiverId
        && incoming().applicantId == existing().applicantId
        && incoming().type == existing().type
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().receiverId == request.auth.uid &&
            existing().status == 'Pending' &&
            incoming().status in ['Accepted', 'Rejected'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isValidId(invitationId) && isVerified() && (
        existing().senderId == request.auth.uid ||
        existing().receiverId == request.auth.uid ||
        isAdmin()
      );
    }

    match /tasks/{taskId} {
      allow get: if isValidId(taskId) && isSignedIn() && (
        existing().projectOwnerId == request.auth.uid ||
        request.auth.uid in existing().teamMemberIds ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().projectOwnerId == request.auth.uid ||
        request.auth.uid in existing().teamMemberIds ||
        isAdmin()
      );

      allow create: if isValidId(taskId)
        && isVerified()
        && incoming().taskId == taskId
        && incoming().createdBy == request.auth.uid
        && incoming().keys().hasAll(['taskId', 'projectId', 'teamId', 'projectOwnerId', 'teamMemberIds', 'title', 'createdBy', 'status', 'priority', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['taskId', 'projectId', 'teamId', 'projectOwnerId', 'teamMemberIds', 'title', 'description', 'assignedTo', 'assignedToName', 'createdBy', 'status', 'priority', 'dueDate', 'createdAt', 'updatedAt'])
        && isValidTask(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && isProjectMember(incoming().projectId);

      allow update: if isValidId(taskId)
        && isVerified()
        && isValidTask(incoming())
        && incoming().taskId == existing().taskId
        && incoming().projectId == existing().projectId
        && incoming().teamId == existing().teamId
        && incoming().projectOwnerId == existing().projectOwnerId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isProjectMember(existing().projectId) && (
            ((existing().projectOwnerId == request.auth.uid || existing().createdBy == request.auth.uid) && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'assignedTo', 'assignedToName', 'status', 'priority', 'dueDate', 'teamMemberIds', 'updatedAt'
            ])) ||
            (request.auth.uid in existing().teamMemberIds && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'assignedTo', 'assignedToName', 'updatedAt'
            ]))
          ))
        );

      allow delete: if isValidId(taskId) && isVerified() && (
        existing().projectOwnerId == request.auth.uid ||
        existing().createdBy == request.auth.uid ||
        isAdmin()
      );
    }

    match /messages/{messageId} {
      allow get: if isValidId(messageId) && isSignedIn() && (
        existing().projectOwnerId == request.auth.uid ||
        request.auth.uid in existing().teamMemberIds ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().projectOwnerId == request.auth.uid ||
        request.auth.uid in existing().teamMemberIds ||
        isAdmin()
      );

      allow create: if isValidId(messageId)
        && isVerified()
        && incoming().messageId == messageId
        && incoming().senderId == request.auth.uid
        && incoming().keys().hasAll(['messageId', 'projectId', 'channel', 'senderId', 'senderName', 'message', 'projectOwnerId', 'teamMemberIds', 'timestamp'])
        && incoming().keys().hasOnly(['messageId', 'projectId', 'channel', 'senderId', 'senderName', 'senderAvatar', 'message', 'projectOwnerId', 'teamMemberIds', 'timestamp'])
        && isValidMessage(incoming())
        && incoming().timestamp == request.time
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && isProjectMember(incoming().projectId);

      allow update: if false;
      allow delete: if isValidId(messageId) && isVerified() && (existing().senderId == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      allow create: if isValidId(notificationId)
        && isVerified()
        && incoming().notificationId == notificationId
        && incoming().actorId == request.auth.uid
        && incoming().read == false
        && incoming().keys().hasAll(['notificationId', 'userId', 'actorId', 'type', 'message', 'read', 'timestamp'])
        && incoming().keys().hasOnly(['notificationId', 'userId', 'actorId', 'type', 'message', 'linkView', 'read', 'timestamp'])
        && isValidNotification(incoming())
        && incoming().timestamp == request.time;

      allow update: if isValidId(notificationId)
        && isVerified()
        && isValidNotification(incoming())
        && incoming().notificationId == existing().notificationId
        && incoming().userId == existing().userId
        && incoming().actorId == existing().actorId
        && incoming().type == existing().type
        && incoming().message == existing().message
        && incoming().timestamp == existing().timestamp
        && (existing().userId == request.auth.uid || isAdmin())
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);

      allow delete: if isValidId(notificationId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().reporterId == request.auth.uid || isAdmin());

      allow create: if isValidId(reportId)
        && isVerified()
        && incoming().reportId == reportId
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'Pending'
        && incoming().keys().hasAll(['reportId', 'reporterId', 'targetType', 'targetId', 'targetTitle', 'reason', 'status', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['reportId', 'reporterId', 'targetType', 'targetId', 'targetTitle', 'reason', 'status', 'createdAt', 'updatedAt'])
        && isValidReport(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(reportId)
        && isAdmin()
        && isValidReport(incoming())
        && incoming().reportId == existing().reportId
        && incoming().reporterId == existing().reporterId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isValidId(reportId) && isAdmin();
    }

    match /savedAnalyses/{analysisId} {
      allow get: if isValidId(analysisId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      allow create: if isValidId(analysisId)
        && isVerified()
        && incoming().analysisId == analysisId
        && incoming().userId == request.auth.uid
        && incoming().keys().hasAll(['analysisId', 'userId', 'ideaPrompt', 'result', 'createdAt'])
        && incoming().keys().hasOnly(['analysisId', 'userId', 'ideaPrompt', 'result', 'createdAt'])
        && isValidSavedAnalysis(incoming())
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isValidId(analysisId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /activities/{activityId} {
      allow get: if isValidId(activityId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      allow create: if isValidId(activityId)
        && isVerified()
        && incoming().activityId == activityId
        && incoming().userId == request.auth.uid
        && incoming().keys().hasAll(['activityId', 'userId', 'action', 'targetTitle', 'dateKey', 'timestamp'])
        && incoming().keys().hasOnly(['activityId', 'userId', 'action', 'targetTitle', 'dateKey', 'timestamp'])
        && isValidActivity(incoming())
        && incoming().timestamp == request.time;

      allow update, delete: if false;
    }
  }
}
